{
  "name": "capsule-firefox-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox adapter for Context Capsule",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:isolated": "node scripts/dev-browser.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "lint": "pnpm build && node scripts/lint.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "package": "pnpm build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@samasante/liquid-glass": "0.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "web-ext": "10.6.0"
  }
}
