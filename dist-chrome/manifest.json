{
  "manifest_version": 3,
  "name": "Context Capsule",
  "version": "0.1.7",
  "description": "Capture and restore Chrome windows, tabs, and tab groups with Context Capsule.",
  "minimum_chrome_version": "105",
  "key": "",
  "icons": {
    "128": "popup/capsule-bgless.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "popup/capsule-bgless.png",
    "default_title": "Context Capsule",
    "default_popup": "popup/popup.html"
  }
}
